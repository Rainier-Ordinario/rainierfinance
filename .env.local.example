# Supabase — from your project's Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the seed script and the Python service. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — used by the Python service
ANTHROPIC_API_KEY=
# Model for the AI advisor (easy to swap)
ANTHROPIC_MODEL=claude-sonnet-5

# Python FastAPI service
NEXT_PUBLIC_PYTHON_API_URL=http://localhost:8000

# Seed script (npm run seed): password for the dev@rainierfinance.test user it creates
SEED_DEV_PASSWORD=

# Plaid bank sync — keys from dashboard.plaid.com → Developers → Keys.
# PLAID_ENV is "sandbox" (test banks) or "production" (your real accounts).
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Encrypts stored bank access tokens. Generate with: openssl rand -base64 32
PLAID_TOKEN_KEY=
# Optional: public URL of /api/plaid/webhook so new transactions sync as
# soon as the bank posts them (e.g. https://your-app.com/api/plaid/webhook).
# Without it the app syncs when you open it and when you press Sync.
PLAID_WEBHOOK_URL=
