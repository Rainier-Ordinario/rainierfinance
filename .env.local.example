# Supabase — from your project's Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the seed script and the Python service. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — used by the Python service
ANTHROPIC_API_KEY=
# Model for the AI advisor (easy to swap)
ANTHROPIC_MODEL=claude-sonnet-5

# Python FastAPI service
NEXT_PUBLIC_PYTHON_API_URL=http://localhost:8000

# Seed script (npm run seed): password for the dev@rainierfinance.test user it creates
SEED_DEV_PASSWORD=
